NODE_ENV=development
PORT=3005

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=abdo
DB_PASSWORD=password
DB_NAME=realestate_db
DB_CONNECTION_LIMIT=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars

# Firebase Admin SDK
# Path to your firebase service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8080
