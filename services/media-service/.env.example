NODE_ENV=development
PORT=3006

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=realestate-media
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars

# File limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8080
