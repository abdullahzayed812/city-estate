NODE_ENV=development
PORT=3002

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=abdo
DB_PASSWORD=password
DB_NAME=realestate_db
DB_CONNECTION_LIMIT=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT (for verifying tokens from auth-service)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars

# Cache TTL (seconds)
PROPERTY_CACHE_TTL=300
FEATURED_CACHE_TTL=600

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8080
